{
  "name": "fit-statnice-migrator",
  "version": "0.1.0",
  "description": "Testing tools for validating migration between FIT-Notes and FIT-Statnice vaults.",
  "main": "main.js",
  "scripts": {
    "dev": "esbuild src/main.ts src/cli.ts --bundle --outdir=. --format=cjs --target=es2018 --platform=node --external:obsidian --external:electron --sourcemap=inline --watch",
    "build": "esbuild src/main.ts src/cli.ts --bundle --outdir=. --format=cjs --target=es2018 --platform=node --external:obsidian --external:electron --minify",
    "test": "jest -c jest.config.cjs",
    "cli:comments": "node cli.js comments",
    "cli:migration": "node cli.js migration",
    "cli:migrate-notes": "node cli.js migrate-notes",
    "cli:test-migrated-cards": "node cli.js test-migrated-cards",
    "cli:all": "node cli.js all",
    "cli:prepare": "node cli.js prepare-sections",
    "cli:anki-sync": "node cli.js anki-sync",
    "version": "node scripts/version-bump.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/jest": "^29.5.12",
    "obsidian": "^1.5.8",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "tslib": "^2.7.0"
  }
}
